# Local development only. Copy this file to the ignored root .dev.vars.
# Local username/password authentication does not require either of these values.
# They remain optional compatibility settings for older provider identities.
APP_OWNER_EMAIL=""
APP_ADMIN_EMAILS=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_BRIDGE_SECRET=""

# Hosted deployment: APP_OWNER_EMAIL and APP_ADMIN_EMAILS are optional compatibility
# settings for older provider identities. The owner is created through /setup.
# APP_ADMIN_EMAILS accepts a comma/semicolon/newline-separated exact allowlist.
# Never commit production values or grant staff rights from a browser field.
# Telegram remains disabled until the bridge secret is configured on the server.
# Use the same random secret (at least 32 characters) in the separate bot process.
# The Telegram Bot API token belongs only in the bot host's secret environment.
